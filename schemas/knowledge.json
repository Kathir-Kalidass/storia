{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "storia/knowledge/event",
  "title": "Knowledge Event",
  "description": "A single knowledge transition event — a fact moving between knowledge types (public/private/secret/unknown) as witnessed by a character.",
  "type": "object",
  "properties": {
    "event_id": { "type": "string" },
    "scene_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "character_id": { "type": "string" },
    "fact": { "type": "string" },
    "fact_id": { "type": "string" },
    "from_type": {
      "type": "string",
      "enum": ["public", "private", "secret", "unknown"]
    },
    "to_type": {
      "type": "string",
      "enum": ["public", "private", "secret", "unknown"]
    },
    "source": {
      "type": "string",
      "enum": ["witnessed", "told", "deduced", "read", "inferred"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "reliability": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "required": ["event_id", "scene_id", "character_id", "fact", "from_type", "to_type", "confidence"]
}
