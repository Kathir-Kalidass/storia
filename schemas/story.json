{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "storia/story/metadata",
  "title": "Story Metadata",
  "description": "Canonical metadata and DNA for a Storia story. The root of every Story State.",
  "type": "object",
  "properties": {
    "story_id": { "type": "string", "pattern": "^[a-z0-9-]{8,64}$" },
    "title": { "type": "string", "maxLength": 200 },
    "genre": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "maxItems": 5
    },
    "language": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
    "secondary_languages": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" }
    },
    "themes": { "type": "array", "items": { "type": "string" }, "maxItems": 10 },
    "target_audience": { "type": "string" },
    "tone": { "type": "string" },
    "pov": { "type": "string" },
    "narrative_style": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["planning", "writing", "revising", "complete", "published"]
    },
    "current_chapter": { "type": "integer", "minimum": 0 },
    "total_chapters": { "type": "integer", "minimum": 0 },
    "word_count_target": { "type": "integer", "minimum": 0 },
    "active_personas": {
      "type": "object",
      "properties": {
        "primary": { "type": "string" },
        "secondary": { "type": "string" },
        "style": { "type": "string" },
        "language": { "type": "string" },
        "audience": { "type": "string" }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "required": ["story_id", "title", "genre", "language", "status", "created_at"]
}
