{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "storia/state/version",
  "title": "Version History Entry",
  "description": "A single entry in the version history log, tracking every state mutation.",
  "type": "object",
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "parent": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "reason": {
      "type": "string",
      "enum": [
        "scene_written", "revision", "manual_edit", "state_synthesized",
        "rollback", "import", "recovery"
      ]
    },
    "scene_id": { "type": "string" },
    "author": {
      "type": "string",
      "enum": ["llm", "user", "synthesizer"]
    },
    "checksum": { "type": "string" },
    "size_bytes": { "type": "integer", "minimum": 0 },
    "sections_changed": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["version", "parent", "timestamp", "reason", "checksum"]
}
