{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "storia/state/timeline",
  "title": "Timeline State",
  "description": "Temporal tracking for a story — current time, season, elapsed time, and chronological markers.",
  "type": "object",
  "properties": {
    "current_time": { "type": ["string", "null"], "format": "date-time" },
    "current_season": {
      "type": "string",
      "enum": ["spring", "summer", "autumn", "fall", "winter", "dry", "wet", "monsoon", "none"]
    },
    "time_since_start": { "type": "number", "minimum": 0 },
    "time_unit": {
      "type": "string",
      "enum": ["seconds", "minutes", "hours", "days", "weeks", "months", "years", "epochs"]
    },
    "current_year": { "type": "integer" },
    "era": { "type": "string" },
    "chronological_markers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "marker_id": { "type": "string" },
          "label": { "type": "string" },
          "time": { "type": "string", "format": "date-time" },
          "description": { "type": "string" }
        },
        "required": ["marker_id", "label", "time"]
      }
    },
    "timezone": { "type": "string" },
    "calendar_system": { "type": "string" }
  },
  "required": ["current_time", "current_season", "time_since_start"]
}
