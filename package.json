{
  "name": "storia",
  "version": "1.0.0-alpha.1",
  "description": "Narrative Intelligence Agent Skill — install with npx skills add Kathir-Kalidass/storia",
  "keywords": [
    "agent-skill", "ai", "llm", "storytelling", "narrative", "writing",
    "worldbuilding", "character-design", "plot", "fiction",
    "npx-skills", "agent"
  ],
  "homepage": "https://github.com/Kathir-Kalidass/storia#readme",
  "bugs": {
    "url": "https://github.com/Kathir-Kalidass/storia/issues"
  },
  "license": "MIT",
  "author": "Kathir Kalidass",
  "main": "lib/index.js",
  "types": "lib/storia.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./errors": "./lib/errors.js",
    "./storia": "./lib/storia.js",
    "./adapters/*": "./lib/adapters/*.js",
    "./plugins/*": "./lib/plugins/*.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "storia": "./lib/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "files": [
    "lib/cli.js",
    "lib/errors.js",
    "lib/index.js",
    "lib/interfaces.js",
    "lib/logger.js",
    "lib/retry.js",
    "lib/security.js",
    "lib/storia.js",
    "lib/storia.d.ts",
    "lib/telemetry.js",
    "lib/adapters/",
    "lib/plugins/",
    "runtime/diff-engine.js",
    "runtime/narrative-intelligence-engine.js",
    "runtime/optimizer.js",
    "runtime/orchestrator.js",
    "runtime/persona-engine.js",
    "runtime/prompt-engine.js",
    "runtime/schema-validator.js",
    "runtime/state-manager.js",
    "runtime/synthesizer.js",
    "runtime/validator.js",
    "runtime/workflow-engine.js",
    "prompts/",
    "schemas/",
    "personas/",
    "workflows/",
    "capabilities/",
    "docs/",
    "SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node runtime/test.js && node lib/sdk.test.js && node test/contract.test.js",
    "test:contract": "node test/contract.test.js",
    "test:sdk": "node lib/sdk.test.js",
    "test:runtime": "node runtime/test.js",
    "demo": "node examples/web-novel-demo.js",
    "cli": "node lib/cli.js",
    "audit": "npm audit --production",
    "outdated": "npm outdated --production",
    "prepublishOnly": "npm test && npm audit --production"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kathir-Kalidass/storia.git"
  }
}
